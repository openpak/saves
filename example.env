# Copy to .env and fill in. No real values belong in this repository.

SAVES_HTTP_ADDR=:20020
# Postgres, database named after the repo (ports.md: dev Postgres on 23000).
SAVES_DATABASE_URL=postgres://saves:secret@localhost:23000/saves
# Shared secret for /internal/* callers: the website and the Switch adapter send it as
# X-Internal-Key. Also signs the blob URLs the allowance hands a console. >=32 bytes.
SAVES_INTERNAL_KEY=
# Seals players' storage credentials at rest (AES-256-GCM). Losing it disconnects every
# player's storage; rotating it means re-entering them. >=32 bytes.
SAVES_CREDENTIAL_KEY=
# Where the allowance's bytes live.
SAVES_LOCAL_DIR=./data
# OpenPak-hosted bytes per account. 1 GiB during the alpha phase (was 256 MiB).
SAVES_ALLOWANCE_BYTES=1073741824
# Set to allow player storage on private, loopback or link-local addresses (a MinIO on this
# host's LAN). Empty refuses them: a URL a player types is a request this service makes from
# inside its own network.
SAVES_ALLOW_PRIVATE_STORAGE=
# Key seed packages (generate_key_seed_package). Paths of files mounted read-only from a secrets
# directory on the host, never from the repo or the image. Either unset answers 503.
#   SIGNING: OpenPak's RSA-2048 private key, PEM (PKCS#8 or PKCS#1), e = 65537.
#   PACKAGE: the 16-byte package key for the generation below, as 16 raw bytes or 32 hex characters.
#   GENERATION: the key generation written into each package (>= 4); the package key must be the one derived for it.
SAVES_KSP_SIGNING_KEY_FILE=
SAVES_KSP_PACKAGE_KEY_FILE=
SAVES_KSP_KEY_GENERATION=4
# Console-facing blob hosts; the adapter forwards both here. Leave as they are.
SAVES_UPLOAD_HOST=scsi-upload.lp1.scsi.srv.nintendo.net
SAVES_DOWNLOAD_HOST=scsi-download.lp1.scsi.srv.nintendo.net
# Title ids allowed to back up on the Switch (policy ALL_OK). Empty allows every title.
SAVES_SWITCH_TITLES=
# Consumer clouds, offered only when OpenPak has registered an OAuth app with the provider.
# Google: a Cloud project with the Drive API enabled and an OAuth client (web application),
# redirect URI https://openpak.org/account/saves/storage/oauth/gdrive/callback, scope drive.file.
# Microsoft: an Entra app registration, redirect URI .../oauth/onedrive/callback, permission
# Files.ReadWrite.AppFolder. Leave empty to offer S3 and WebDAV only.
SAVES_GOOGLE_CLIENT_ID=
SAVES_GOOGLE_CLIENT_SECRET=
SAVES_MICROSOFT_CLIENT_ID=
SAVES_MICROSOFT_CLIENT_SECRET=
